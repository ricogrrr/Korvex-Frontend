# Point the launcher at a real websocket backend.
# `npm run dev:ws` serves the SQLite-backed server on ws://localhost:8787.
# Sign-in is Microsoft device-code inside the launcher — no token here.
# Unset (or empty) keeps the fixture backend — no backend needed for dev.
# Frames are {request_id, service, method, input} JSON until the proto layer lands.
VITE_WS_URL=ws://localhost:8787
